# Required for the household unlock screen in production.
# Use single quotes around secrets containing $ or #. Keep this file private once filled in.
KINDLING_ADMIN_PASSWORD=
KINDLING_SESSION_SECRET=

# Use your ZimaOS LAN address and published Readarr ports, including any URL base.
# localhost inside Docker points to Kindling itself, not to your other containers.
READARR_BASE_URL=http://192.168.1.50:8787
READARR_API_KEY=
AUDIOBOOK_READARR_BASE_URL=http://192.168.1.50:8788
AUDIOBOOK_READARR_API_KEY=

# Optional contact used to identify Kindling to Open Library for its higher API rate limit.
OPENLIBRARY_CONTACT_EMAIL=

# Optional Kindle delivery. Preserve these values from your existing installation.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_MAX_ATTACHMENT_BYTES=18874368

# Docker Compose host settings. Point the books directory at downloaded EPUBs.
KINDLING_PORT=3000
KINDLING_DATA_DIR=./data
KINDLING_BOOKS_DIR=./watched-books
KINDLING_UID=1000
KINDLING_GID=1000

# Optional Readarr defaults; paths and profile IDs belong to the target instance.
READARR_ROOT_FOLDER_PATH=
READARR_QUALITY_PROFILE_ID=
READARR_METADATA_PROFILE_ID=
AUDIOBOOK_READARR_ROOT_FOLDER_PATH=
AUDIOBOOK_READARR_QUALITY_PROFILE_ID=
AUDIOBOOK_READARR_METADATA_PROFILE_ID=
READARR_SYNC_INTERVAL_SECONDS=120

# Optional public origin when using a reverse proxy, e.g. https://books.example.com
KINDLING_TRUSTED_ORIGINS=
KINDLING_SESSION_TTL_HOURS=168
DELIVERY_SCAN_INTERVAL_SECONDS=60

# Local development settings. Docker fixes the database path and disables the embedded worker.
DATABASE_PATH=./data/kindling.db
KINDLING_EMBEDDED_WORKER=false
