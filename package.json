{
  "name": "kindling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-worker.mjs",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx lib/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx lib/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx lib/db/seed.ts",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.10.0"
  }
}
